# Copiez ce fichier en ".env" puis modifiez les valeurs.
PORT=3000
# OBLIGATOIRE pour accéder à /admin (au moins 10 caractères)
ADMIN_PASSWORD=
# Facultatif : clé de signature des sessions admin (sinon aléatoire, les sessions s'arrêtent au redémarrage)
SESSION_SECRET=
# Dossier des données (messages, contenu, fichiers envoyés). À placer sur un disque PERSISTANT en production.
DATA_DIR=./data
# À mettre à 1 derrière un proxy (Nginx, Render, Railway, Fly…) pour lire la vraie IP des visiteurs
TRUST_PROXY=0
# Facultatif : si le site est hébergé ailleurs (ex. GitHub Pages), son adresse exacte, ex. https://pseudo.github.io
CORS_ORIGIN=
# Facultatif : URL de webhook (Slack, Discord, Make…) prévenue à chaque nouveau message
NOTIFY_WEBHOOK=
